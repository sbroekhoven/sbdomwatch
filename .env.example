# Copy to .env and keep it private (chmod 600). Never commit .env.
# Read by docker compose (env_file) and by sbdomwatch itself (--env-file, default ./.env).
# Variables already set in the environment win over this file.
# API token, at least 32 characters. `make config` fills in a random one.
SBDOMWATCH_TOKEN=
SBDOMWATCH_DISCORD_WEBHOOK=
# Client side: where the CLI finds the API.
SBDOMWATCH_URL=http://127.0.0.1:8480
